model User {
  id        String   @id @default(uuid())
  email     String   @unique /// @zod.string.email({ message: "Invalid email format" })
  password  String   /// @zod.string.min(6, { message: "Password must be at least 6 characters" })
  createdAt DateTime @default(now())

  tasks     Task[]
  memberships Membership[]
}